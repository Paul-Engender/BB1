{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-task-ledger-row.schema.json",
  "title": "Bootstrap Task Ledger Row",
  "type": "object",
  "required": [
    "task_id",
    "task_name",
    "status",
    "owner",
    "dependencies",
    "output_paths",
    "validation_method",
    "validation_evidence",
    "evidence_row_ids",
    "last_updated"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^(BPL|BR|TASK)-[A-Za-z0-9_.-]+$" },
    "bootstrap_task_id": { "type": "string", "pattern": "^BPL-[A-Za-z0-9_.-]+$" },
    "task_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["TO_DO", "IN_PROGRESS", "BLOCKED", "COMPLETED", "DONE", "DID_NOT_DO"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "string" },
    "artifact_output": { "type": "string" },
    "canonical_refs": { "type": "string" },
    "evidence_row_ids": { "type": "string" },
    "input_refs": { "type": "string" },
    "output_paths": { "type": "string" },
    "validation_method": { "type": "string", "minLength": 1 },
    "validation_evidence": { "type": "string" },
    "notes": { "type": "string" },
    "last_updated": { "type": "string" }
  },
  "additionalProperties": true
}
