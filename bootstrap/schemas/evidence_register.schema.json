{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-evidence-register-row.schema.json",
  "title": "Bootstrap Evidence Register Row",
  "type": "object",
  "required": [
    "evidence_row_id",
    "gate_criterion",
    "required_artifact",
    "integrity",
    "validation_method",
    "validation_evidence",
    "status",
    "verification_owner",
    "source_task_ids"
  ],
  "properties": {
    "evidence_row_id": { "type": "string", "pattern": "^EP-[A-Za-z0-9_.-]+$" },
    "evidence_id": { "type": "string", "pattern": "^EP-[A-Za-z0-9_.-]+$" },
    "description": { "type": "string" },
    "gate_criterion": { "type": "string", "minLength": 1 },
    "canonical_refs": { "type": "string" },
    "required_artifact": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "integrity": { "type": "string" },
    "verification_method": { "type": "string" },
    "validation_method": { "type": "string", "minLength": 1 },
    "validation_evidence": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["TO_DO", "COMPLETED", "DONE", "VERIFIED", "BLOCKED"]
    },
    "verification_owner": { "type": "string", "minLength": 1 },
    "source_task_ids": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
