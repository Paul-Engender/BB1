{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-artifact-registry-row.schema.json",
  "title": "Bootstrap Artifact Registry Row",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "produced_by_task_id",
    "path",
    "integrity_type",
    "integrity_value",
    "validation_status",
    "validation_evidence",
    "evidence_row_ids"
  ],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^ART-[A-Za-z0-9_.-]+$" },
    "artifact_type": {
      "type": "string",
      "enum": ["DOC", "CODE", "SCHEMA", "FIXTURE", "TEST_OUTPUT", "BUILD_ARTIFACT", "REPORT", "OTHER"]
    },
    "produced_by_task_id": { "type": "string", "pattern": "^(BPL|BR|TASK)-[A-Za-z0-9_.-]+$" },
    "path": { "type": "string", "minLength": 1 },
    "integrity_type": { "type": "string", "enum": ["SHA256", "NONE"] },
    "integrity_value": { "type": "string" },
    "validation_status": {
      "type": "string",
      "enum": ["TO_DO", "COMPLETED", "DONE", "VERIFIED", "BLOCKED"]
    },
    "validation_evidence": { "type": "string" },
    "evidence_row_ids": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
