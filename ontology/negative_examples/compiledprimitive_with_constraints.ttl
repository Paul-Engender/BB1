@prefix kern:   <https://ontology.engender.co.za/kernel#> .
@prefix ex:     <https://ontology.engender.co.za/example#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

ex:DomainEntity_123 a owl:Thing .

ex:TargetRef_123 a kern:TargetReference ;
    kern:isAboutEntity ex:DomainEntity_123 ;
    kern:hasExternalIdentifier ex:ExternalId_GCP_123 .

ex:ExternalId_GCP_123 a kern:ExternalIdentifier ;
    kern:identifierScheme "gcp-resource-name"^^xsd:anyURI ;
    kern:identifierValue "projects/my-proj/instances/vm-123" .

ex:ActionKind_Provision a kern:ActionKind .
ex:EffectKind_Update a kern:EffectKind .

ex:TargetSet_001 a kern:TargetSet ;
    kern:targetSetId "ts-001" ;
    kern:targetSelectionBasis "explicit-membership" ;
    kern:hasTargetMember ex:TargetRef_123 .

ex:Scope_001 a kern:ScopeBoundary ;
    kern:scopeId "scope-tenant-core" ;
    kern:targetSetRef ex:TargetSet_001 .

ex:Action_001 a kern:ActionSpecification ;
    kern:actionId "action-001" ;
    kern:actionKindRef ex:ActionKind_Provision .

ex:Effect_001 a kern:EffectSpecification ;
    kern:effectId "effect-001" ;
    kern:effectKindRef ex:EffectKind_Update .

ex:Binding_001 a kern:ActionEffectBinding ;
    kern:actionEffectBindingId "binding-001" ;
    kern:actionRef ex:Action_001 ;
    kern:effectRef ex:Effect_001 .

ex:AuthorizationSemantic_001 a kern:AuthorizationSemantic ;
    kern:actionRef ex:Action_001 ;
    kern:targetSetRef ex:TargetSet_001 ;
    kern:authorizationDecisionKindRef kern:AuthorizationAllow .

ex:EligibilitySemantic_001 a kern:EligibilitySemantic ;
    kern:actionRef ex:Action_001 ;
    kern:eligibilityStatusRef kern:EligibilityEligible .

ex:DenialSemantic_001 a kern:DenialSemantic ;
    kern:denialKindRef kern:DenialAuthorization .

ex:ControlStateSemantic_001 a kern:ControlStateSemantic ;
    kern:actionRef ex:Action_001 ;
    kern:controlStateKindRef kern:ControlStateHardStop .

ex:WorkflowInput_001 a kern:TenantWorkflowInput ;
    kern:tenantId "tenant-001" ;
    kern:workflowId "workflow-001" ;
    kern:workflowVersion "1.0.0" ;
    kern:domainId "domain-ops" ;
    kern:routingPolicyId "routing-default" ;
    kern:targetSetRef ex:TargetSet_001 ;
    kern:scopeRef ex:Scope_001 ;
    kern:actionRef ex:Action_001 ;
    kern:effectRef ex:Effect_001 ;
    kern:actionEffectBindingRef ex:Binding_001 ;
    kern:authorizationSemanticsRef ex:AuthorizationSemantic_001 ;
    kern:eligibilitySemanticsRef ex:EligibilitySemantic_001 ;
    kern:denialSemanticsRef ex:DenialSemantic_001 ;
    kern:controlStateSemanticsRef ex:ControlStateSemantic_001 ;
    kern:aiOperable true .

ex:SupportReleaseRef_001 a kern:SupportReleaseReference ;
    kern:compileTraceId "support-release-ref-001" ;
    kern:releaseArtifactId "cid:support-release-001" ;
    kern:releaseVersion "0.2.0" .

ex:DependencyBinding_001 a kern:DependencyBindingRecord ;
    kern:compileTraceId "dependency-binding-001" ;
    kern:supportReleaseRef ex:SupportReleaseRef_001 .

ex:GateExecution_001 a kern:GateExecutionRecord ;
    kern:compileTraceId "gate-execution-001" ;
    kern:sourceInputRef ex:WorkflowInput_001 .

ex:CompileDecision_001 a kern:CompileDecisionRecord ;
    kern:compileTraceId "compile-decision-001" ;
    kern:sourceInputRef ex:WorkflowInput_001 .

ex:EvidenceDigest_001 a kern:EvidenceDigestRecord ;
    kern:compileTraceId "evidence-digest-001" .

ex:OutcomeSummary_001 a kern:CompileOutcomeSummary ;
    kern:compileTraceId "compile-outcome-summary-001" .

ex:CompileTrace_001 a kern:CompileTraceReference ;
    kern:compileTraceId "compile-trace-001" ;
    kern:sourceInputRef ex:WorkflowInput_001 ;
    kern:dependencyBindingRef ex:DependencyBinding_001 ;
    kern:gateExecutionRecordRef ex:GateExecution_001 ;
    kern:compileDecisionRecordRef ex:CompileDecision_001 ;
    kern:evidenceDigestRecordRef ex:EvidenceDigest_001 ;
    kern:compileOutcomeSummaryRef ex:OutcomeSummary_001 .

ex:ReasonPolicy_001 a kern:CompileReasonCodePolicy ;
    kern:policyId "reason-policy-001" ;
    kern:reasonCodePattern "RC:S6:I20:MISSING_EVIDENCE_LINK" ;
    kern:reasonCodeDetailToken "MISSING_EVIDENCE_LINK" ;
    kern:reasonCodeCategoryRef kern:ReasonCodeMissingEvidenceLink .
ex:ActionEffectPrimitive_001 a kern:CompiledControlPrimitive, kern:ActionEffectPrimitive ;
    kern:primitiveId "actioneffectprimitive_001" ;
    kern:primitiveTypeRef kern:ActionEffectPrimitiveType ;
    kern:tenantId "tenant-001" ;
    kern:workflowId "workflow-001" ;
    kern:targetSetRef ex:TargetSet_001 ;
    kern:scopeRef ex:Scope_001 ;
    kern:actionRef ex:Action_001 ;
    kern:effectRef ex:Effect_001 ;
    kern:authorizationSemanticsRef ex:AuthorizationSemantic_001 ;
    kern:eligibilitySemanticsRef ex:EligibilitySemantic_001 ;
    kern:denialSemanticsRef ex:DenialSemantic_001 ;
    kern:controlStateSemanticsRef ex:ControlStateSemantic_001 ;
    kern:supportReleaseRef ex:SupportReleaseRef_001 ;
    kern:sourceInputRef ex:WorkflowInput_001 ;
    kern:compileReasonCodePolicyRef ex:ReasonPolicy_001 ;
    kern:compileTraceRef ex:CompileTrace_001 ;
    kern:constraints "unsupported-mvp-constraint"  .
