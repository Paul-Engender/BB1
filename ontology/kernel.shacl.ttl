@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix kern:   <https://ontology.engender.co.za/kernel#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

kern:TargetReferenceShape a sh:NodeShape ;
  sh:targetClass kern:TargetReference ;
  sh:property [
    sh:path kern:isAboutEntity ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path kern:hasExternalIdentifier ;
    sh:minCount 1 ;
    sh:class kern:ExternalIdentifier ;
  ] .

kern:ExternalIdentifierShape a sh:NodeShape ;
  sh:targetClass kern:ExternalIdentifier ;
  sh:property [
    sh:path kern:identifierScheme ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:anyURI ;
  ] ;
  sh:property [
    sh:path kern:identifierValue ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .

kern:StipulationShape a sh:NodeShape ;
  sh:targetClass kern:Stipulation ;
  sh:property [
    sh:path kern:hasStipulationNature ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (kern:Restriction kern:Grant kern:Evaluator kern:Assertion) ;
  ] ;
  sh:property [
    sh:path kern:stipulatesOn ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetReference ;
  ] .

kern:EvaluatorStipulationShape a sh:NodeShape ;
  sh:targetClass kern:Stipulation ;
  sh:or (
    [
      sh:not [
        sh:property [
          sh:path kern:hasStipulationNature ;
          sh:hasValue kern:Evaluator ;
        ]
      ]
    ]
    [
      sh:property [
        sh:path kern:hasStipulationNature ;
        sh:hasValue kern:Evaluator ;
      ] ;
      sh:property [
        sh:path kern:usesMeasurementSpecification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class kern:MeasurementSpecification ;
      ]
    ]
  ) .

kern:RestrictionGrantExpressionShape a sh:NodeShape ;
  sh:targetClass kern:Stipulation ;
  sh:or (
    [
      sh:not [
        sh:property [
          sh:path kern:hasStipulationNature ;
          sh:in (kern:Restriction kern:Grant) ;
        ]
      ]
    ]
    [
      sh:property [
        sh:path kern:hasStipulationNature ;
        sh:in (kern:Restriction kern:Grant) ;
        sh:minCount 1 ;
      ] ;
      sh:property [
        sh:path kern:ruleExpression ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
      ]
    ]
  ) .

kern:PromotionRecordShape a sh:NodeShape ;
  sh:targetClass kern:PromotionRecord ;
  sh:property [
    sh:path kern:promotesCandidate ;
    sh:minCount 1 ;
    sh:class kern:InformationContent ;
  ] ;
  sh:property [
    sh:path kern:producesAcceptedAssertion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TruthAssertion ;
  ] .

kern:TruthAssertionShape a sh:NodeShape ;
  sh:targetClass kern:TruthAssertion ;
  sh:property [
    sh:path kern:isAbout ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetReference ;
  ] .

kern:TargetSetShape a sh:NodeShape ;
  sh:targetClass kern:TargetSet ;
  sh:property [
    sh:path kern:targetSetId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:targetSelectionBasis ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .

kern:ScopeBoundaryShape a sh:NodeShape ;
  sh:targetClass kern:ScopeBoundary ;
  sh:property [
    sh:path kern:scopeId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:targetSetRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetSet ;
  ] .

kern:ActionSpecificationShape a sh:NodeShape ;
  sh:targetClass kern:ActionSpecification ;
  sh:property [
    sh:path kern:actionId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:actionKindRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionKind ;
  ] .

kern:EffectSpecificationShape a sh:NodeShape ;
  sh:targetClass kern:EffectSpecification ;
  sh:property [
    sh:path kern:effectId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:effectKindRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EffectKind ;
  ] .

kern:ActionEffectBindingShape a sh:NodeShape ;
  sh:targetClass kern:ActionEffectBinding ;
  sh:property [
    sh:path kern:actionEffectBindingId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:effectRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EffectSpecification ;
  ] .

kern:AuthorizationSemanticShape a sh:NodeShape ;
  sh:targetClass kern:AuthorizationSemantic ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:targetSetRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetSet ;
  ] ;
  sh:property [
    sh:path kern:authorizationDecisionKindRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (kern:AuthorizationAllow kern:AuthorizationDeny) ;
  ] .

kern:EligibilitySemanticShape a sh:NodeShape ;
  sh:targetClass kern:EligibilitySemantic ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:eligibilityStatusRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (kern:EligibilityEligible kern:EligibilityIneligible kern:EligibilityUnknown) ;
  ] .

kern:DenialSemanticShape a sh:NodeShape ;
  sh:targetClass kern:DenialSemantic ;
  sh:property [
    sh:path kern:denialKindRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (kern:DenialAuthorization kern:DenialEligibility kern:DenialQuarantine kern:DenialAbort) ;
  ] .

kern:ControlStateSemanticShape a sh:NodeShape ;
  sh:targetClass kern:ControlStateSemantic ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:controlStateKindRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:in (kern:ControlStateHardStop kern:ControlStateResume kern:ControlStateModeTransition) ;
  ] .

kern:TenantWorkflowInputShape a sh:NodeShape ;
  sh:targetClass kern:TenantWorkflowInput ;
  sh:property [
    sh:path kern:tenantId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:workflowId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:workflowVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:domainId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:routingPolicyId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:targetSetRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetSet ;
  ] ;
  sh:property [
    sh:path kern:scopeRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ScopeBoundary ;
  ] ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:effectRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EffectSpecification ;
  ] ;
  sh:property [
    sh:path kern:actionEffectBindingRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionEffectBinding ;
  ] ;
  sh:property [
    sh:path kern:authorizationSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:AuthorizationSemantic ;
  ] ;
  sh:property [
    sh:path kern:eligibilitySemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EligibilitySemantic ;
  ] ;
  sh:property [
    sh:path kern:denialSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:DenialSemantic ;
  ] ;
  sh:property [
    sh:path kern:controlStateSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ControlStateSemantic ;
  ] ;
  sh:property [
    sh:path kern:aiOperable ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] .

kern:TenantWorkflowInputNoConstraintsShape a sh:NodeShape ;
  sh:targetClass kern:TenantWorkflowInput ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:SupportReleaseReferenceShape a sh:NodeShape ;
  sh:targetClass kern:SupportReleaseReference ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:releaseArtifactId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:releaseVersion ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:DependencyBindingRecordShape a sh:NodeShape ;
  sh:targetClass kern:DependencyBindingRecord ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:supportReleaseRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:SupportReleaseReference ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:GateExecutionRecordShape a sh:NodeShape ;
  sh:targetClass kern:GateExecutionRecord ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:sourceInputRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TenantWorkflowInput ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:CompileDecisionRecordShape a sh:NodeShape ;
  sh:targetClass kern:CompileDecisionRecord ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:sourceInputRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TenantWorkflowInput ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:EvidenceDigestRecordShape a sh:NodeShape ;
  sh:targetClass kern:EvidenceDigestRecord ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:CompileOutcomeSummaryShape a sh:NodeShape ;
  sh:targetClass kern:CompileOutcomeSummary ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:CompileTraceReferenceShape a sh:NodeShape ;
  sh:targetClass kern:CompileTraceReference ;
  sh:property [
    sh:path kern:compileTraceId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:sourceInputRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TenantWorkflowInput ;
  ] ;
  sh:property [
    sh:path kern:dependencyBindingRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:DependencyBindingRecord ;
  ] ;
  sh:property [
    sh:path kern:gateExecutionRecordRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:GateExecutionRecord ;
  ] ;
  sh:property [
    sh:path kern:compileDecisionRecordRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CompileDecisionRecord ;
  ] ;
  sh:property [
    sh:path kern:evidenceDigestRecordRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EvidenceDigestRecord ;
  ] ;
  sh:property [
    sh:path kern:compileOutcomeSummaryRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CompileOutcomeSummary ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:CompileReasonCodePolicyShape a sh:NodeShape ;
  sh:targetClass kern:CompileReasonCodePolicy ;
  sh:property [
    sh:path kern:policyId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:reasonCodePattern ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:reasonCodeDetailToken ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:reasonCodeCategoryRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ReasonCodeCategory ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

kern:CompiledControlPrimitiveShape a sh:NodeShape ;
  sh:targetClass kern:CompiledControlPrimitive ;
  sh:property [
    sh:path kern:primitiveId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:primitiveTypeRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CompiledPrimitiveType ;
  ] ;
  sh:property [
    sh:path kern:tenantId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:workflowId ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:scopeRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ScopeBoundary ;
  ] ;
  sh:property [
    sh:path kern:targetSetRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TargetSet ;
  ] ;
  sh:property [
    sh:path kern:actionRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ActionSpecification ;
  ] ;
  sh:property [
    sh:path kern:effectRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EffectSpecification ;
  ] ;
  sh:property [
    sh:path kern:authorizationSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:AuthorizationSemantic ;
  ] ;
  sh:property [
    sh:path kern:eligibilitySemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:EligibilitySemantic ;
  ] ;
  sh:property [
    sh:path kern:denialSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:DenialSemantic ;
  ] ;
  sh:property [
    sh:path kern:controlStateSemanticsRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:ControlStateSemantic ;
  ] ;
  sh:property [
    sh:path kern:supportReleaseRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:SupportReleaseReference ;
  ] ;
  sh:property [
    sh:path kern:sourceInputRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TenantWorkflowInput ;
  ] ;
  sh:property [
    sh:path kern:compileReasonCodePolicyRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CompileReasonCodePolicy ;
  ] ;
  sh:property [
    sh:path kern:compileTraceRef ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CompileTraceReference ;
  ] ;
  sh:property [
    sh:path kern:constraints ;
    sh:maxCount 0 ;
  ] .

# PM branch shapes aligned to kernel_fixed.ttl

kern:ValidationSpecificationShape a sh:NodeShape ;
  sh:targetClass kern:ValidationSpecification ;
  sh:property [
    sh:path kern:validationMethod ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:passCondition ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:failCondition ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path kern:expectsEvidenceRecord ;
    sh:minCount 1 ;
    sh:class kern:EvidenceRecord ;
  ] .

kern:ProgramPlanShape a sh:NodeShape ;
  sh:targetClass kern:ProgramPlan ;
  sh:property [
    sh:path kern:hasSubPlan ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:hasCheckpoint ;
    sh:class kern:CheckpointSpecification ;
  ] .

kern:WorkstreamPlanShape a sh:NodeShape ;
  sh:targetClass kern:WorkstreamPlan ;
  sh:property [
    sh:path kern:hasSubPlan ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:hasCheckpoint ;
    sh:class kern:CheckpointSpecification ;
  ] .

kern:WorkPackagePlanShape a sh:NodeShape ;
  sh:targetClass kern:WorkPackagePlan ;
  sh:property [
    sh:path kern:hasSubPlan ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:hasCheckpoint ;
    sh:class kern:CheckpointSpecification ;
  ] .

kern:TaskSpecificationShape a sh:NodeShape ;
  sh:targetClass kern:TaskSpecification ;
  sh:property [
    sh:path kern:hasValidationSpecification ;
    sh:minCount 1 ;
    sh:class kern:ValidationSpecification ;
  ] ;
  sh:property [
    sh:path kern:plannedInput ;
    sh:class kern:InformationContent ;
  ] ;
  sh:property [
    sh:path kern:plannedOutput ;
    sh:class kern:InformationContent ;
  ] ;
  sh:property [
    sh:path kern:dependsOnPlan ;
    sh:class kern:Plan ;
  ] .

kern:TaskExecutionRecordShape a sh:NodeShape ;
  sh:targetClass kern:TaskExecutionRecord ;
  sh:property [
    sh:path kern:recordsExecutionOf ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TaskSpecification ;
  ] ;
  sh:property [
    sh:path kern:evidencesActivity ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:TaskExecutionActivity ;
  ] .

kern:TaskExecutionActivityShape a sh:NodeShape ;
  sh:targetClass kern:TaskExecutionActivity .

kern:CheckpointSpecificationShape a sh:NodeShape ;
  sh:targetClass kern:CheckpointSpecification .

kern:CheckpointRecordShape a sh:NodeShape ;
  sh:targetClass kern:CheckpointRecord ;
  sh:property [
    sh:path kern:assessesCheckpoint ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:CheckpointSpecification ;
  ] .

kern:DependencyRelationShape a sh:NodeShape ;
  sh:targetClass kern:DependencyRelation ;
  sh:property [
    sh:path kern:dependencySource ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:dependencyTarget ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:hasDependencyKind ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:DependencyKind ;
  ] .

kern:DependencyLagConsistencyShape a sh:NodeShape ;
  sh:targetClass kern:DependencyRelation ;
  sh:or (
    [
      sh:not [ sh:property [ sh:path kern:hasLagValue ; sh:minCount 1 ] ]
    ]
    [
      sh:property [
        sh:path kern:hasLagValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
      ] ;
      sh:property [
        sh:path kern:lagUnit ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
      ]
    ]
  ) .

kern:RiskRecordShape a sh:NodeShape ;
  sh:targetClass kern:RiskRecord ;
  sh:property [
    sh:path kern:likelihoodValue ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path kern:impactValue ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] .

kern:RiskThreatBindingShape a sh:NodeShape ;
  sh:targetClass kern:RiskRecord ;
  sh:or (
    [ sh:property [ sh:path kern:threatensPlan ; sh:minCount 1 ; sh:class kern:Plan ] ]
    [ sh:property [ sh:path kern:threatensCheckpoint ; sh:minCount 1 ; sh:class kern:CheckpointSpecification ] ]
  ) .

kern:IssueRecordShape a sh:NodeShape ;
  sh:targetClass kern:IssueRecord .

kern:MitigationPlanShape a sh:NodeShape ;
  sh:targetClass kern:MitigationPlan ;
  sh:or (
    [ sh:property [ sh:path kern:mitigatesRisk ; sh:minCount 1 ; sh:class kern:RiskRecord ] ]
    [ sh:property [ sh:path kern:mitigatesIssue ; sh:minCount 1 ; sh:class kern:IssueRecord ] ]
  ) .

kern:ChangeRequestShape a sh:NodeShape ;
  sh:targetClass kern:ChangeRequest ;
  sh:property [
    sh:path kern:requestsChangeTo ;
    sh:minCount 1 ;
    sh:class kern:InformationContent ;
  ] ;
  sh:property [
    sh:path kern:hasImpactAssessment ;
    sh:minCount 1 ;
    sh:class kern:ImpactAssessment ;
  ] .

kern:ImpactAssessmentShape a sh:NodeShape ;
  sh:targetClass kern:ImpactAssessment .

kern:EffortEstimateShape a sh:NodeShape ;
  sh:targetClass kern:EffortEstimate ;
  sh:property [
    sh:path kern:estimatedValue ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path kern:estimateUnit ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .

kern:ResourceAllocationShape a sh:NodeShape ;
  sh:targetClass kern:ResourceAllocation ;
  sh:property [
    sh:path kern:allocationQuantity ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path kern:allocationUnit ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .

kern:RoleAssignmentShape a sh:NodeShape ;
  sh:targetClass kern:RoleAssignment ;
  sh:property [
    sh:path kern:assignsAgent ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:Agent ;
  ] ;
  sh:property [
    sh:path kern:assignsRole ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class kern:Role ;
  ] ;
  sh:property [
    sh:path kern:assignmentScopePlan ;
    sh:minCount 1 ;
    sh:class kern:Plan ;
  ] ;
  sh:property [
    sh:path kern:assignmentValidFrom ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path kern:assignmentValidTo ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .

kern:HumanAgentShape a sh:NodeShape ;
  sh:targetClass kern:HumanAgent .

kern:SystemAgentShape a sh:NodeShape ;
  sh:targetClass kern:SystemAgent .

