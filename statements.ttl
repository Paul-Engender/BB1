ssreq:REQ_NODE_DECLARED_ENTITY_MINIMUM_METADATA_Shape sh:target _:node5 .

_:node5 sh:select """
SELECT $this WHERE {
  { $this rdfs:label ?l } UNION { $this skos:prefLabel ?l }
  FILTER NOT EXISTS { $this rdf:type owl:Ontology }
}
""" .

_:node6 sh:select """
SELECT $this WHERE {
  { $this rdfs:label ?l } UNION { $this skos:prefLabel ?l }
  FILTER NOT EXISTS { $this rdf:type owl:Ontology }
  OPTIONAL { $this skos:notation ?n . }
  FILTER ( !bound(?n) || !regex(str(?n), \"^[A-Z][A-Za-z0-9]*(_[A-Z][A-Za-z0-9]*)*$\") )
}
""";
  sh:message "Missing or invalid skos:notation for declared non-ontology entity." .

_:node203 sh:select """
SELECT $this WHERE {
  $this u2:U2_0000103 ?decider .
  $this u2:U2_0000124 ?proposal .
  ?proposal u0:U0_0000123 ?author .
  FILTER(?decider = ?author)
}
""";
  sh:message "Separation of duties: decision maker must not be the proposal author." .

