u0:U0_0000002 skos:definition "Declared resulting occurrent for an actuation attempt. Does not claim causality or correctness.";
  skos:prefLabel "Declared Effect Occurrent" .

u0:U0_0000005 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Declared Effect" .

u0:U0_0000008 skos:definition "Persists through time; identity-bearing.";
  skos:prefLabel "Persistent Identity" .

u0:U0_0000003 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Actuation Agent" .

u0:U0_0000012 skos:definition "Stable referential handle used to maintain reference under partial context and identity churn.";
  skos:prefLabel "Identity Anchor" .

u0:U0_0000004 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Actuation Target" .

u0:U0_0000026 skos:definition "Assertive content proposed for potential use; not accepted.";
  skos:prefLabel "Assertion Candidate" .

u0:U0_0000006 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Justification Assertion" .

u0:U0_0000001 skos:definition "Actuation attempt representation. u0 enables safe execution context but never authorizes execution.";
  skos:prefLabel "Actuation Attempt" .

u0:U0_0000013 skos:definition "External key (scheme + value) used to bind an anchor to external identity systems.";
  skos:prefLabel "Anchor Key" .

u0:U0_0000024 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Has Key" .

u0:U0_0000020 skos:definition "Optional binding to a currently-resolved persistent entity. Not required to exist.";
  skos:prefLabel "Anchors Persistent" .

u0:U0_0000015 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Key Scheme" .

u0:U0_0000016 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Key Value" .

u0:U0_0000019 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "State Time" .

u0:U0_0000017 skos:definition "Mechanical state code (e.g., resolved, unresolved, ambiguous). No privileged semantics.";
  skos:prefLabel "State Code" .

u0:U0_0000014 skos:definition "Non-authoritative resolution snapshot for an anchor (representational, time-indexed). Does not imply correctness, permission, or acceptance.";
  skos:prefLabel "Identity Anchor State" .

u0:U0_0000029 skos:definition "Mechanical extraction/run occurrent that consumes records and produces candidate assertions. Carries provenance; never implies acceptance, permission, or truth.";
  skos:prefLabel "Extraction Run" .

u0:U0_0000046 skos:definition "Links a candidate assertion to the extraction run that produced it.";
  skos:prefLabel "Produced By Run" .

u0:U0_0000042 skos:definition "Primary anchor asserted-about by a candidate assertion.";
  skos:prefLabel "Asserts About" .

u0:U0_0000034 skos:definition "Supporting material that may be linked to candidate assertions; does not entail.";
  skos:prefLabel "Supporting Material" .

u0:U0_0000045 skos:definition "Links candidate assertions to supporting material. Support does not entail.";
  skos:prefLabel "Has Support" .

u0:U0_0000036 skos:definition "Locator scheme identifier (e.g., page-line, byte-span, xpath, jsonpath).";
  skos:prefLabel "Locator Scheme" .

u0:U0_0000037 skos:definition "Locator value under the declared scheme.";
  skos:prefLabel "Locator Value" .

u0:U0_0000028 skos:definition "Normalized locator describing where supporting evidence occurs within a source (e.g., page/line/span/offset/hash). Locator does not entail correctness.";
  skos:prefLabel "Evidence Locator" .

u0:U0_0000032 skos:definition "System or authority record. Does not imply acceptance.";
  skos:prefLabel "System or Authority Record" .

u0:U0_0000047 skos:definition "Links an extraction run to records it consumed.";
  skos:prefLabel "Run Consumed Record" .

u0:U0_0000048 skos:definition "Links an extraction run to candidate assertions it produced.";
  skos:prefLabel "Run Produced Candidate" .

u0:U0_0000038 skos:definition "Timestamp for the extraction run. Mechanical metadata only.";
  skos:prefLabel "Run Time" .

u0:U0_0000039 skos:definition "Identifier for the tool/agent that performed the extraction run.";
  skos:prefLabel "Tool ID" .

u0:U0_0000040 skos:definition "Version identifier for the tool/agent that performed the extraction run.";
  skos:prefLabel "Tool Version" .

u0:U0_0000035 skos:definition "Deterministic fingerprint of the run inputs (records + configuration). Enables replay and comparison.";
  skos:prefLabel "Input Fingerprint" .

u0:U0_0000033 skos:definition "Originating system/container for records and supporting material. This is not an access mechanism and does not imply permission.";
  skos:prefLabel "Source System" .

u0:U0_0000043 skos:definition "Indicates the source system/container from which a record originates. No access or authorization semantics.";
  skos:prefLabel "From Source System" .

u0:U0_0000011 skos:definition "Role bearer must be explicit.";
  skos:prefLabel "Role Bearer" .

u0:U0_0000009 skos:definition "Context-dependent classification; not identity-bearing. Roles do not act, decide, or persist as bearers.";
  skos:prefLabel "Non-Authoritative Description" .

u0:U0_0000050 skos:definition "Links supporting material to the record from which it was derived. Provides traceability; does not entail acceptance.";
  skos:prefLabel "Support Derived From Record" .

u0:U0_0000044 skos:definition "Associates supporting material with one or more evidence locators.";
  skos:prefLabel "Has Locator" .

u1:U1_0000005 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Claim Type' is a class used to represent a first-class construct on this layer's semantic axis. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Claim Type" .

u1:U1_0000034 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Claim Permission Type' is an object property relating u1:U1_0000003 to u1:U1_0000005. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Claim Permission Type" .

u1:U1_0000027 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'claim_permit' is an individual value used within this layer's governance/assurance vocabulary. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "claim_permit" .

u1:U1_0000026 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'claim_forbid' is an individual value used within this layer's governance/assurance vocabulary. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "claim_forbid" .

u1:U1_0000025 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'claim_conditional' is an individual value used within this layer's governance/assurance vocabulary. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "claim_conditional" .

u1:U1_0000035 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Claim Permission Value' is an object property relating u1:U1_0000003 to u1:U1_0000004. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Claim Permission Value" .

u1:U1_0000003 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Claim Permission' is a class used to represent a first-class construct on this layer's semantic axis. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Claim Permission" .

u3:U3_0000024 skos:definition "In layer u3 (Mapping (mapped structural workflow constructs and participation; non-executive; non-governance)), 'Qualified Pattern' is a class used to represent a first-class construct on this layer's semantic axis. It represents mapped structure only; it does not represent execution and confers no governance authority.";
  skos:prefLabel "Qualified Pattern" .

