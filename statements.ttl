u0:U0_0000041 skos:definition "All representation aboutness is mediated via anchors in u0.";
  skos:prefLabel "About Anchor" .

u0:U0_0000030 skos:definition "Superclass for representational artifacts. Representation is not identical to referent.";
  skos:prefLabel "Representational Artifact" .

u1:U1_0000051 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Profile Scope' is an object property relating u1:U1_0000013 to u1:U1_0000016. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Profile Scope" .

u1:U1_0000015 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Ruleset' is a class used to represent a first-class construct on this layer's semantic axis. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Ruleset" .

u1:U1_0000050 skos:definition "In layer u1 (Agreement/Proposal (non-authoritative proposals for governance consideration)), 'Profile Ruleset' is an object property relating u1:U1_0000013 to u1:U1_0000015. It does not imply acceptance, eligibility, approval, or truth.";
  skos:prefLabel "Profile Ruleset" .

<https://ontology.engender.co.za/semstack/u0> skos:definition "u0 defines referential primitives, category safety, representation/aboutness, and actuation prerequisites. u0 contains no permission, governance, or acceptance semantics.";
  skos:prefLabel "Semantic Stack u0 - Understanding Layer" .

u0:U0_0000010 skos:definition "Canonical asserted participation direction.";
  skos:prefLabel "Has Participant" .

u0:U0_0000007 skos:definition "Happens in time; not identity-bearing.";
  skos:prefLabel "Occurrent" .

u0:U0_0000121 skos:definition "Producer attribution for evidence artefacts. Provenance-only; confers no authority and has zero governance effect.";
  skos:prefLabel "Evidence Recorded By" .

u0:U0_0000057 skos:definition "Representational evidence artefact (documents, observations, measurements). Evidence is not truth and has no governance force by itself.";
  skos:prefLabel "Evidence Artefact" .

u0:U0_0000122 skos:definition "Producer attribution for mechanism/extraction runs. Provenance-only; confers no authority and has zero governance effect.";
  skos:prefLabel "Mechanism Executed By" .

u0:U0_0000123 skos:definition "Producer attribution for proposal artefacts. Provenance-only; confers no authority and has zero governance effect.";
  skos:prefLabel "Proposal Authored By" .

u0:U0_0000058 skos:definition "Non-authoritative structured proposal derived from evidence. Proposals may be evaluated by governance but cannot change governance state.";
  skos:prefLabel "Proposal Artefact" .

u0:U0_0000018 skos:definition "Mechanical method code for how the state was produced (e.g., exact-key, fuzzy-match).";
  skos:prefLabel "State Method" .

u0:U0_0000021 skos:definition "Identity continuity link indicating this anchor is a merge of prior anchors.";
  skos:prefLabel "Anchor Merges From" .

u0:U0_0000022 skos:definition "Identity continuity link indicating this anchor splits to subsequent anchors.";
  skos:prefLabel "Anchor Splits To" .

u0:U0_0000023 skos:definition "Identity continuity link (new anchor supersedes old anchor). No governance or acceptance semantics.";
  skos:prefLabel "Anchor Supersedes" .

u0:U0_0000025 skos:definition "A u0 entity within foundational representation and category discipline for the stack.";
  skos:prefLabel "Has State" .

u0:U0_0000031 skos:definition "First-class extracted mention (span/cell/log-line) used as support for candidate assertions. Does not entail correctness or acceptance.";
  skos:prefLabel "Extracted Mention" .

u0:U0_0000049 skos:definition "Inverse-style link (optional). May be added when support is linked to a candidate assertion.";
  skos:prefLabel "Supports Assertion" .

u0:U0_0000052 skos:definition "Authority-bearing and governance semantics (decisions, admissibility, promotion).";
  skos:prefLabel "Governance Plane" .

u0:U0_0000051 skos:definition "Typing construct used to keep governance, mechanism, sensemaking, and strategy narrative semantics explicitly separated.";
  skos:prefLabel "Semantic Plane" .

u0:U0_0000053 skos:definition "Causal execution, orchestration, control, and observation semantics. No governance force.";
  skos:prefLabel "Mechanism Plane" .

u0:U0_0000054 skos:definition "Explicitly permitted exploratory semantics. Non-authoritative and quarantined.";
  skos:prefLabel "Sensemaking Plane" .

u0:U0_0000056 skos:definition "Assigns an explicit semantic plane to an artefact to prevent plane collapse (governance vs mechanism vs sensemaking vs narrative).";
  skos:prefLabel "Has Semantic Plane" .

u0:U0_0000061 skos:definition "Exploratory, non-authoritative artefact in the sensemaking perimeter. Must not be treated as evidence, proposal, decision, or accepted construct without explicit reclassification.";
  skos:prefLabel "Sensemaking Artefact" .

u0:U0_0000059 skos:definition "Explicit decision record. A decision may be authoritative only when exercised under an appropriate mandate; absence of such mandate is meaningful.";
  skos:prefLabel "Decision Record" .

u0:U0_0000060 skos:definition "A construct promoted for admissible downstream use by explicit governance decision. Not metaphysical truth.";
  skos:prefLabel "Accepted Construct" .

u0:U0_0000074 skos:definition "Governance transition type: claim scope expanded.";
  skos:prefLabel "Claim Scope Expanded" .

u0:U0_0000075 skos:definition "Governance transition type: claim scope narrowed.";
  skos:prefLabel "Claim Scope Narrowed" .

u0:U0_0000076 skos:definition "Governance transition type: mandate issued.";
  skos:prefLabel "Mandate Issued" .

u0:U0_0000077 skos:definition "Governance transition type: mandate revoked.";
  skos:prefLabel "Mandate Revoked" .

u0:U0_0000078 skos:definition "Governance transition type: schema change accepted.";
  skos:prefLabel "Schema Change Accepted" .

u0:U0_0000079 skos:definition "Governance transition type: prior decision superseded.";
  skos:prefLabel "Decision Superseded" .

u0:U0_0000087 skos:definition "Relates a governed operating asset to an explicit eligibility state assertion for a specific scope.";
  skos:prefLabel "Has Eligibility State" .

u0:U0_0000094 skos:definition "A non-human agent/system actor that may assist but cannot hold mandate or issue governance Decisions.";
  skos:prefLabel "Automation Agent" .

u0:U0_0000096 skos:definition "Links a Decision to the accountable agent who issued it under mandate.";
  skos:prefLabel "Decided By" .

u0:U0_0000101 skos:definition "Links a Novelty Signal to the Schema Version it deems insufficient.";
  skos:prefLabel "Indicates Insufficiency Of Schema" .

u0:U0_0000097 skos:definition "A non-authoritative signal that the current schema is insufficient for a case; never grants promotion.";
  skos:prefLabel "Novelty Signal" .

u0:U0_0000098 skos:definition "A versioned representation of the ontology/schema in force.";
  skos:prefLabel "Schema Version" .

u0:U0_0000102 skos:definition "Links a Novelty Signal to a Schema Change Proposal intended to resolve it.";
  skos:prefLabel "Addressed By Proposal" .

u0:U0_0000099 skos:definition "A non-authoritative proposal to evolve the schema; requires explicit acceptance by Decision.";
  skos:prefLabel "Schema Change Proposal" .

u0:U0_0000103 skos:definition "Links a Schema Change Decision to the Schema Change Proposal it accepts.";
  skos:prefLabel "Accepts Schema Change Proposal" .

u0:U0_0000100 skos:definition "A Decision that accepts a Schema Change Proposal and enacts the Schema Change Accepted transition.";
  skos:prefLabel "Schema Change Decision" .

u0:U0_0000104 skos:definition "Links a Schema Version to the prior Schema Version it supersedes.";
  skos:prefLabel "Supersedes Schema Version" .

u0:U0_0000107 skos:definition "A kernel constraint forbidding a governance state transition from being caused by mechanism execution or other non-authoritative triggers.";
  skos:prefLabel "Forbidden Transition Constraint" .

u0:U0_0000105 skos:definition "A kernel constraint forbidding an inference from a non-authoritative signal to authority, truth, or eligibility.";
  skos:prefLabel "Forbidden Inference Constraint" .

u0:U0_0000108 skos:definition "Links a forbidden inference/transition constraint to an Enforcement Control.";
  skos:prefLabel "Enforced By Control" .

u0:U0_0000106 skos:definition "An abstract control asserting the invariant is enforced via representation, validation, and/or audit.";
  skos:prefLabel "Enforcement Control" .

u0:U0_0000111 skos:definition "Links a Value Chain to its narrative stages (Strategy Narrative Concepts).";
  skos:prefLabel "Has Narrative Stage" .

u0:U0_0000110 skos:definition "A non-authoritative narrative value chain used in strategy framing.";
  skos:prefLabel "Value Chain" .

u0:U0_0000109 skos:definition "A non-authoritative narrative concept used for strategy framing; cannot justify governance decisions.";
  skos:prefLabel "Strategy Narrative Concept" .

u0:U0_0000112 skos:definition "Narrative customer value chain stages from the Strategy document.";
  skos:prefLabel "Customer Value Chain" .

u0:U0_0000055 skos:definition "Business framing and narrative semantics. Non-authoritative unless explicitly promoted into governed constructs.";
  skos:prefLabel "Strategy Narrative Plane" .

u0:U0_0000114 skos:definition "Non-authoritative strategy narrative stage.";
  skos:prefLabel "Operational Reality" .

u0:U0_0000115 skos:definition "Non-authoritative strategy narrative stage.";
  skos:prefLabel "Agent-Ready Operations" .

u0:U0_0000116 skos:definition "Non-authoritative strategy narrative stage.";
  skos:prefLabel "Assured Delivery" .

u0:U0_0000117 skos:definition "Non-authoritative strategy narrative stage.";
  skos:prefLabel "Outcome Advantage" .

u0:U0_0000113 skos:definition "Narrative business value chain stages from the Strategy document.";
  skos:prefLabel "Business Value Chain" .

u0:U0_0000118 skos:definition "Non-authoritative strategy narrative stage.";
  skos:prefLabel "Operational Evidence Access" .

u0:U0_0000119 skos:definition "Non-authoritative strategy narrative stage.";
