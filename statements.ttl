ssreq:REQ_NODE_DECLARED_ENTITY_MINIMUM_METADATA_Shape a sh:NodeShape;
  rdfs:comment "Any ontology-surface entity declared via rdfs:label or skos:prefLabel must have an explicit rdf:type, a canonical skos:definition, a human-readable skos:prefLabel, and a machine-oriented skos:notation in Pascal_Snake_Case.";
  rdfs:label "Requirement: declared entities must be typed, named, and defined" .

_:node1 a sh:PropertyShape .

_:node2 a sh:PropertyShape .

_:node3 a sh:PropertyShape .

_:node4 a sh:PropertyShape .

_:node5 a sh:SPARQLTarget .

<https://ontology.engender.co.za/semstack/shacl/req#REQ_NODE_DECLARED_ENTITY_NOTATION_NON_ONTOLOGY_Shape>
  a sh:NodeShape;
  rdfs:comment "Any ontology-surface entity declared via rdfs:label or skos:prefLabel that is not owl:Ontology must have exactly one skos:notation matching the naming policy.";
  rdfs:label "Requirement: declared non-ontology entities must have a machine label" .

_:node6 a sh:SPARQLConstraint .

